// Prisma schema for the Poke-Collect mystery pack app.
// Hosted on Railway Postgres; DATABASE_URL is provided by the Railway Postgres plugin.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum SeriesStatus {
  DRAFT // cards being set up, not on sale
  LIVE // pool shuffled and committed, packs on sale
  CLOSED // no longer drawing (sold out or closed by the merchant)
}

// One sellable run of packs with a fixed card list, e.g. "Series 1: 500 packs at $10".
model Series {
  id               String       @id @default(cuid())
  shop             String
  title            String
  handle           String
  status           SeriesStatus @default(DRAFT)
  // The Shopify product variant customers buy (the pack itself).
  packProductId    String
  // Reusable across series: only one draft or live series may use a pack at a time.
  packVariantId    String
  packPrice        Decimal      @db.Decimal(10, 2)
  // Unopened packs are revealed automatically after this many days so orders can ship.
  autoOpenDays     Int          @default(1)
  // Auto-built pools draw from the shop's live inventory: each card's copies are moved to
  // "reserved" at launch so they can only be won from packs, and released when the series closes.
  reserveInventory Boolean      @default(false)
  // [{ name, min }] lowest first; a card's tier is the highest one its value reaches.
  tierRules        Json?
  // Last rules used to auto-build the pool, to prefill the form.
  buildRules       Json?
  // Provable fairness: sha256(salt + ordered slot list) published at launch,
  // salt published after the series closes.
  commitHash       String?
  salt             String?
  launchedAt       DateTime?
  closedAt         DateTime?
  // Set once when the last card of the top tier is pulled (fires the Shopify Flow alert).
  topTierGoneAt    DateTime?
  // Cards in each pack (1 for classic packs; e.g. 5 for a booster-style pack). Each card is its own slot.
  cardsPerPack     Int          @default(1)
  // Staff test cards (put in a staff vault by /jobs/staff-test-cards): never on sale as packs, and on
  // Vault Market only the owner and customers tagged "vault-tester" can see them.
  staffTest        Boolean      @default(false)
  // Singles customers bought on the website and chose "Keep In My Vault" for (one series per shop).
  // Already sold and out of stock, so shipping them later adds a $0 custom line, not the variant.
  storePurchase    Boolean      @default(false)
  // What the pool's cards would cost at our StorePass buylist offers (see lib/buylist.server.ts).
  buylistReport    Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  cardbitLaunchBatches CardbitLaunchBatch[]
  cards Card[]
  slots Slot[]
  pulls Pull[]

  @@unique([shop, handle])
  @@index([shop, packVariantId])
}

// A card in the pool. Each card is a hidden Shopify variant with real inventory.
model Card {
  id              String  @id @default(cuid())
  seriesId        String
  series          Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  variantId       String
  productId       String
  title           String
  imageUrl        String?
  tier            String
  marketValue     Decimal @db.Decimal(10, 2)
  quantity        Int
  sortOrder       Int     @default(0)
  // Where this card's stock is reserved (auto-built pools only).
  inventoryItemId String?
  locationId      String?
  // Copies currently held in Shopify's "reserved" state for this series.
  reservedQty     Int     @default(0)

  slots Slot[]

  @@unique([seriesId, variantId])
}

// One physical copy of a card in a series. At launch every slot is given a
// position in a cryptographically shuffled sequence; packs claim positions in order.
model Slot {
  id       String  @id @default(cuid())
  seriesId String
  series   Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  cardId   String
  card     Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  position Int?
  claimed  Boolean @default(false)
  // Voided slots belonged to a refunded/cancelled unopened pack; the card returns to stock.
  voided   Boolean @default(false)

  pull Pull?

  @@unique([seriesId, position])
  @@index([seriesId, claimed, voided])
}

enum PullStatus {
  UNOPENED // drawn at payment, not yet revealed to the customer
  REVEALED // customer (or auto-open) revealed it
  FULFILLING // card added to the order, holds released
  VOIDED // order refunded or cancelled before the card shipped
}

model Pull {
  id            String       @id @default(cuid())
  shop          String
  seriesId      String
  series        Series       @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  slotId        String       @unique
  slot          Slot         @relation(fields: [slotId], references: [id])
  orderId       String // gid://shopify/Order/...
  orderName     String
  lineItemId    String // gid://shopify/LineItem/... of the pack line
  packIndex     Int // 0-based copy within that line item's quantity
  cardIndex     Int          @default(0) // 0-based card within a multi-card pack
  customerId    String? // gid://shopify/Customer/...
  status        PullStatus   @default(UNOPENED)
  revealedAt    DateTime?
  autoOpened    Boolean      @default(false)
  fulfillingAt  DateTime?
  // Set once this pull's reserved copy is moved back to available for the order edit.
  unreservedAt  DateTime?
  // Vault orders: the "ship to me" request this card is on, and the order that ships it.
  shipRequestId String?
  shipRequest   ShipRequest? @relation(fields: [shipRequestId], references: [id])
  shipOrderId   String?
  // When the customer was reminded this vaulted card is near the end of its holding period.
  remindedAt    DateTime?
  // Vault marketplace: shown on the Trade Board, and when it last changed owners by trade or sale.
  openToTrade   Boolean      @default(false)
  transferredAt DateTime?
  // The pack order was refunded after this card changed owners: staff decide, the card is not voided.
  refundFlaggedAt DateTime?
  createdAt     DateTime     @default(now())
  tradeItems    TradeItem[]
  listings      Listing[]
  transfers     PullTransfer[]
  cardbitBuyback CardbitBuyback?

  @@unique([lineItemId, packIndex, cardIndex])
  @@index([orderId])
  @@index([customerId])
  @@index([status, createdAt])
}

// Per-order bookkeeping for orders that contain packs.
model PackOrder {
  orderId              String    @id
  shop                 String
  orderName            String
  customerId           String?
  // Random token for the "open your packs" link (lets guests open without logging in).
  openToken            String    @unique
  // The checkout's token (order.checkout_token), so the thank-you page can find this order's packs.
  checkoutToken        String?
  held                 Boolean   @default(false)
  // Set right after the order edit commits, so a retry never adds the cards twice.
  cardsAddedAt         DateTime?
  // Lease so the reveal request and the cron job never finalize the same order at once.
  finalizingAt         DateTime?
  finalized            Boolean   @default(false)
  // Vault orders keep pulled cards in the customer's vault until they ask to have them shipped,
  // instead of adding them to this order. Orders from before the vault have this false.
  vault                Boolean   @default(false)
  // Vault orders: when the pulled cards were written to the order's note (cards aren't line items).
  pullsNotedAt         DateTime?
  // Vault orders: when the pack lines were marked fulfilled (at payment).
  packLinesFulfilledAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([shop, checkoutToken])
}

// A customer's "ship my cards" request: a draft order for the vaulted cards plus the shipping fee.
model ShipRequest {
  id           String   @id @default(cuid())
  shop         String
  customerId   String?
  // PENDING until the invoice is paid; EXPIRED if it lapses (cards go back to the vault).
  status       String   @default("PENDING")
  draftOrderId String?
  invoiceUrl   String?
  orderId      String?
  cardCount    Int
  quoteKey     String?
  shippingFee  Decimal  @db.Decimal(10, 2)
  // Local pickup instead of shipping; readyAt is when the "ready for pickup" email went out.
  pickup       Boolean  @default(false)
  readyAt      DateTime?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  pulls        Pull[]

  @@index([shop, status])
}

// ---- Vault marketplace: players trade or sell vault cards to each other (never to the store) ----

model MarketSettings {
  shop           String   @id
  // Off until the merchant turns it on in the admin; selling has its own switch.
  enabled        Boolean  @default(false)
  sellingEnabled Boolean  @default(false)
  // Kept from each sale before the seller's store credit.
  feePercent     Decimal  @default(10) @db.Decimal(5, 2)
  // Vault Credit codes only work on products in these collections (never Mystery Packs).
  creditCollectionIds String[] @default([])
  // Whether Vault Credit codes combine with other product / order discounts.
  creditCombines Boolean @default(false)
  // Soft launch: when set, only customers with this Shopify tag can use Vault Market.
  accessTag      String?
  updatedAt      DateTime @updatedAt
}

// A player's public trade name. Real names and emails are never shown to other players.
model Trader {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  tradeName  String
  nameKey    String // lowercased, for uniqueness
  // Opt-in: other players can browse this player's whole vault (otherwise only cards they put up).
  showCollection Boolean @default(false)
  // Up to 6 pull ids pinned at the top of their collection page.
  showcase   String[] @default([])
  // Which Vault Market Terms version they agreed to, and when (needed before selling, buying or trading).
  termsVersion    String?
  termsAcceptedAt DateTime?
  createdAt  DateTime @default(now())

  @@unique([shop, customerId])
  @@unique([shop, nameKey])
}

enum TradeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
  REVERSED
}

// An offer from one player to another: cards given for cards received, final once accepted.
model Trade {
  id             String      @id @default(cuid())
  shop           String
  fromCustomerId String
  toCustomerId   String
  status         TradeStatus @default(PENDING)
  note           String?
  // The offer this one counters (that one is declined when this is sent).
  counterOfId    String?
  expiresAt      DateTime
  respondedAt    DateTime?
  reversedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          TradeItem[]

  @@index([shop, status])
  @@index([fromCustomerId])
  @@index([toCustomerId])
}

model TradeItem {
  id      String @id @default(cuid())
  tradeId String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  pullId  String
  pull    Pull   @relation(fields: [pullId], references: [id])
  // GIVE: the proposer's card. GET: the card the proposer asks for.
  side    String

  @@index([pullId])
}

enum ListingStatus {
  ACTIVE // on the Trade Board with a price
  CHECKOUT // a buyer holds an unpaid invoice for it
  SOLD
  CANCELLED
}

// A vault card a player has put up for sale to other players. The buyer pays through a Shopify
// invoice; the seller gets store credit (price minus the fee) once the hold period passes.
model Listing {
  id                String        @id @default(cuid())
  shop              String
  pullId            String
  pull              Pull          @relation(fields: [pullId], references: [id])
  sellerCustomerId  String
  price             Decimal       @db.Decimal(10, 2)
  status            ListingStatus @default(ACTIVE)
  buyerCustomerId   String?
  draftOrderId      String?
  invoiceUrl        String?
  // The one-off "Vault Card" variant (with the card's picture) on this purchase's checkout.
  checkoutVariantId String?
  checkoutExpiresAt DateTime?
  // Vault Credit taken off the buyer's balance and applied as a discount on this checkout's invoice.
  // Given back if the invoice lapses, the card can't move, or the sale is reversed.
  creditApplied     Decimal?      @db.Decimal(10, 2)
  orderId           String?
  orderName         String?
  soldAt            DateTime?
  // HELD until payoutDueAt, then PAID as store credit. FLAGGED (refund/chargeback) or CANCELLED (sale reversed) stop it.
  payoutStatus      String?
  payoutAmount      Decimal?      @db.Decimal(10, 2)
  payoutDueAt       DateTime?
  paidOutAt         DateTime?
  flagReason        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([shop, status])
  @@index([pullId])
  @@index([sellerCustomerId])
  @@index([payoutStatus, payoutDueAt])
}

// Every change of owner made by the marketplace, for staff and reversals.
model PullTransfer {
  id             String   @id @default(cuid())
  shop           String
  pullId         String
  pull           Pull     @relation(fields: [pullId], references: [id])
  fromCustomerId String
  toCustomerId   String
  reason         String // TRADE | SALE | REVERSAL
  tradeId        String?
  listingId      String?
  createdAt      DateTime @default(now())

  @@index([pullId])
}

// A card a player is looking for, by the single's Shopify variant (the same card across series).
model WishItem {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  variantId  String
  title      String
  imageUrl   String?
  // Pulls already emailed about, so each newly available copy alerts once.
  alertedPullIds String[] @default([])
  createdAt  DateTime @default(now())

  @@unique([shop, customerId, variantId])
  @@index([shop, variantId])
}

// Vault Credit: the marketplace's own balance. Shopify checkout never sees it, so it can't buy
// Mystery Packs. Every change is a signed ledger row; the balance is their sum.
model CreditTxn {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  amount     Decimal  @db.Decimal(10, 2)
  // SALE (seller paid) | PURCHASE (bought a card, or credit put toward a card checkout) | PURCHASE_RETURN | CODE (spent on a store code) | CODE_RETURN | ADJUST
  kind       String
  listingId  String?
  codeId     String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([shop, customerId])
}

// A one-time Shopify discount code made from Vault Credit, limited to eligible collections.
model CreditCode {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  code       String   @unique
  amount     Decimal  @db.Decimal(10, 2)
  discountId String?
  // ACTIVE until used, returned or expired.
  status     String   @default("ACTIVE")
  orderId    String?
  orderName  String?
  usedAmount Decimal? @db.Decimal(10, 2)
  // How much of usedAmount has gone back to Vault Credit through refunds (partial or full).
  refundedAmount Decimal @default(0) @db.Decimal(10, 2)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([shop, customerId])
  @@index([status, expiresAt])
}

// Cardbit's signed Shopify test integration. QA and ordinary Poke-Collect records are distinct.
model CardbitWallet {
  shop       String
  customerId String
  balance    Int      @default(0)
  held       Boolean  @default(false)
  @@id([shop, customerId])
}

model CardbitReceipt {
  id          String   @id @default(cuid())
  shop        String
  eventKey    String
  customerId  String
  fingerprint String
  actorId     String?
  reason      String?
  balanceAfter Int?
  source      String  @default("wallet")
  qualifyingPaidCents Int @default(0)
  kind        String
  delta       Int
  openingId   String?
  copyId      String?
  createdAt   DateTime @default(now())
  @@unique([shop, eventKey])
  @@index([shop, customerId, createdAt])
}

model CardbitBuyback {
  copyId    String   @id
  copy      Pull     @relation(fields: [copyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  shop      String
  customerId String
  amount    Int
  expiresAt DateTime
  acceptedAt DateTime?
  @@index([shop, customerId])
}

model CardbitAgeConfirmation {
  shop        String
  customerId  String
  source      String
  confirmedAt DateTime @default(now())

  @@id([shop, customerId])
}

// Cardbit levels: XP has no cash value. Each award is recorded once per event key.
model CardbitProfile {
  shop           String
  customerId     String
  xp             Int      @default(0)
  iconId         String?
  iconColor      String?
  sleeveId       String? // Pack Pass card sleeve (site; shown only while perks apply)
  revealFx       String? // Pack Pass reveal effect: character id, "off", or null = icon's character
  streak         Int      @default(0)
  lastCheckInDay String?
  updatedAt      DateTime @updatedAt
  @@id([shop, customerId])
}

model CardbitXpEvent {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  eventKey   String
  kind       String
  xp         Int
  source     String?
  createdAt  DateTime @default(now())
  @@unique([shop, eventKey])
  @@index([shop, customerId, createdAt])
}

// Sparks: consolation currency, no cash value, not transferable, spent only in the Spark Shop.
model CardbitSparkWallet {
  shop       String
  customerId String
  balance    Int    @default(0)
  @@id([shop, customerId])
}

model CardbitSparkTxn {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  eventKey   String
  kind       String
  delta      Int
  source     String?
  note       String?
  createdAt  DateTime @default(now())
  @@unique([shop, eventKey])
  @@index([shop, customerId, createdAt])
}

// Daily Spinner: one stored result per customer per Cardbit day. Card prizes point at the vaulted pull.
model CardbitSpin {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  day        String
  tier       String
  streak     Int      @default(0)
  prizeKind  String
  amount     Int?
  pullId     String?  @unique
  copyId     String?  @unique // standalone site: the SiteCopy won from the spin's prize pool
  valueBits  Int? // card prizes: the card's Cardbit retail when won (Official Rules ARV caps)
  createdAt  DateTime @default(now())
  @@unique([shop, customerId, day, tier])
}

model CardbitDemoAccount {
  shop       String
  customerId String
  state      Json

  @@id([shop, customerId])
}

model CardbitDeskBook {
  shop          String @id
  revision      Int @default(0)
  policy        Json
  actor         String?
  referenceDate String?
  refreshedAt   DateTime?
  // Exact-printing reference prices. Shopify alone supplies available quantities.
  references    Json
  variants      Json
}

model CardbitDeskTick {
  id     String @id @default(cuid())
  shop   String
  key    String
  at     DateTime
  bits   Int?
  market Int?
  @@unique([shop, key, at])
}

model CardbitVaultMark {
  shop     String
  customer String
  source   String
  day      String
  at       DateTime
  bits     Int?
  market   Int?
  @@id([shop, customer, source, day])
}

// Each row preserves the exact Shopify comparison quantities and repeatable key across a lost response.
model CardbitLaunchBatch {
  seriesId    String
  index       Int
  revision    String
  moves       Json
  series Series @relation(fields:[seriesId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  cancelling Boolean @default(false)
  releasedAt DateTime?
  generation  Int @default(0)
  attemptedAt DateTime?
  confirmedAt DateTime?
  @@id([seriesId, index])
}

model CardbitShelfReceipt {
  shop       String
  eventKey   String
  digest     String
  quantity   Int
  createdAt  DateTime @default(now())
  @@id([shop, eventKey])
}

model CardbitShelfCopy {
  id          String @id @default(cuid())
  shop        String
  eventKey    String
  unit        Int
  variantId   String
  lookKey     String
  faceKey     String
  title       String
  details     String
  image       String?
  locationId  String?
  slot        Int?
  pocket      Int?
  filedAt     DateTime?
  poolSlotId  String? @unique
  parcelId    String?
  shippedAt   DateTime?
  lastSlot    Int?
  createdAt   DateTime @default(now())
  @@unique([shop, eventKey, unit])
  @@unique([shop, slot, pocket])
  @@unique([shop, slot, lookKey])
  @@unique([shop, slot, faceKey])
  @@index([shop, variantId, slot])
  @@index([shop, parcelId])
}

model CardbitShelfBinding {
  poolSlotId String @id
  shop       String
  copyId     String
  boundAt    DateTime @default(now())
  @@index([shop, copyId])
}

model CardbitShelfParcel {
  id            String @id
  shop          String
  orderId       String
  state         String @default("READY")
  manifest      Json
  revision      String
  actor         String
  tracking      String?
  carrier       String?
  labelResultId String?
  labelState    String?
  fulfillmentId String?
  updatedAt     DateTime @updatedAt
  @@index([shop, orderId])
}

// The Cardbit daily drawing uses the same transaction and wallet database as paid funding.
model CardbitGiveawayConfig {
  shop String @id
  enabled Boolean @default(false)
  rulesUrl String @default("")
  freeInstructions String @default("")
  referralEntries Int @default(500)
  shareEntries Int @default(100)
  updatedAt DateTime @updatedAt
}

model CardbitGiveawayPerson {
  shop String
  customerId String
  code String @unique @default(uuid())
  referredBy String?
  whatnotAt DateTime?
  region String
  ageConfirmedAt DateTime
  held Boolean @default(false)
  @@id([shop, customerId])
}

model CardbitGiveawayRound {
  shop String
  day String
  opensAt DateTime
  closesAt DateTime
  seed String
  commitment String
  closedAt DateTime?
  winnerId String?
  participantCount Int @default(0)
  totalEntries Int @default(0)
  snapshot Json?
  snapshotHash String?
  notifiedAt DateTime?
  @@id([shop, day])
  @@index([shop, closedAt, closesAt])
}

model CardbitGiveawayEvent {
  id String @id @default(cuid())
  shop String
  day String
  customerId String
  key String
  kind String
  entries Int
  voided Boolean @default(false)
  note String?
  actor String?
  postedAt DateTime @default(now())
  @@unique([shop, key])
  @@index([shop, day, customerId])
}

model CardbitGiveawayAudit {
  id String @id @default(cuid())
  shop String
  actor String
  action String
  detail String
  createdAt DateTime @default(now())
  @@index([shop, createdAt])
}

// Reused giveaway campaign, entrant, audit and prize-queue records.
enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  ARCHIVED
}

model Campaign {
  id            String         @id @default(cuid())
  shop          String
  slug          String
  title         String
  description   String?
  prize         String?
  imageUrl      String?
  status        CampaignStatus @default(DRAFT)
  startsAt      DateTime?
  endsAt        DateTime?
  timezone      String         @default("America/New_York")
  // Purchase rules (base points, product/bundle rules, boosters). Validated by
  // app/lib/entries/rules.ts before it is saved.
  purchaseRules Json?
  // Bot policy thresholds; see app/lib/bot/policy.ts for the default.
  riskPolicy    Json?
  // Branding for the storefront widget (colors, copy).
  theme         Json?
  // Winner email, consolation discount, Klaviyo and outbound webhook settings.
  // Shape: app/lib/settings.ts.
  settings      Json?
  rulesText     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  actions     EntryAction[]
  entrants    Entrant[]
  events      EntryEvent[]
  orders      OrderLog[]
  draws       Draw[]
  dailyPrizes DailyPrize[]
  dailyQueue  DailyQueueItem[]

  @@unique([shop, slug])
  @@index([shop, status])
}

enum ActionType {
  SIGNUP
  REFERRAL
  SOCIAL_FOLLOW
  VISIT_URL
  DAILY_CHECKIN
  SECRET_CODE
  ALTERNATE_ENTRY
  CUSTOM
  POLL
  QUESTION
  WATCH_VIDEO
  SOCIAL_SHARE
  SMS_OPTIN
}

model EntryAction {
  id         String     @id @default(cuid())
  campaignId String
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type       ActionType
  label      String
  entries    Int        @default(1)
  // Type-specific settings, e.g. { url } for VISIT_URL or { code } for SECRET_CODE.
  config     Json?
  mandatory  Boolean    @default(false)
  repeatable Boolean    @default(false)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())

  events    EntryEvent[]
  responses ActionResponse[]
}

// Answers to POLL and QUESTION actions.
model ActionResponse {
  id        String      @id @default(cuid())
  actionId  String
  action    EntryAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  entrantId String
  entrant   Entrant     @relation(fields: [entrantId], references: [id], onDelete: Cascade)
  answer    String
  createdAt DateTime    @default(now())

  @@unique([actionId, entrantId])
}

enum EntrantStatus {
  PENDING_VERIFICATION
  ACTIVE
  HELD
  DISQUALIFIED
}

model Entrant {
  id                 String        @id @default(cuid())
  campaignId         String
  campaign           Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email              String
  // Canonical form (lowercased, gmail dots/+tags stripped) used for de-duplication.
  emailNormalized    String
  name               String?
  shopifyCustomerId  String?
  status             EntrantStatus @default(PENDING_VERIFICATION)
  verifiedAt         DateTime?
  referralCode       String        @unique
  referredById       String?
  referredBy         Entrant?      @relation("Referrals", fields: [referredById], references: [id])
  referrals          Entrant[]     @relation("Referrals")
  riskScore          Int           @default(0)
  // Hashed (HMAC) network/device identifiers; raw IPs are never stored.
  ipHash             String?
  subnetHash         String?
  deviceHash         String?
  userAgent          String?
  utm                Json?
  marketingConsent   Boolean       @default(false)
  // Consolation discount code sent after the draw, if any.
  discountCode       String?
  klaviyoSyncedAt    DateTime?
  // Set by the SMS_OPTIN action: E.164 number and when the entrant agreed to texts.
  phone              String?
  smsConsentAt       DateTime?
  // Whether they were already on the store's lists before entering (Shopify customer record),
  // so analytics can count genuinely new customers and subscribers. Null until checked.
  existingCustomer   Boolean?
  emailWasSubscribed Boolean?
  smsWasSubscribed   Boolean?
  listsCheckedAt     DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  events      EntryEvent[]
  responses   ActionResponse[]
  riskSignals RiskSignal[]
  otps        EmailOtp[]
  wins        Winner[]

  @@unique([campaignId, emailNormalized])
  @@index([campaignId, status])
  @@index([campaignId, ipHash])
  @@index([campaignId, subnetHash])
  @@index([campaignId, deviceHash])
  @@index([campaignId, phone])
}

enum EntrySource {
  ACTION
  PURCHASE
  REFERRAL
  ADJUSTMENT
  ROLLBACK
  IMPORT
}

model EntryEvent {
  id         String       @id @default(cuid())
  campaignId String
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  entrantId  String
  entrant    Entrant      @relation(fields: [entrantId], references: [id], onDelete: Cascade)
  source     EntrySource
  actionId   String?
  action     EntryAction? @relation(fields: [actionId], references: [id], onDelete: SetNull)
  orderLogId String?
  orderLog   OrderLog?    @relation(fields: [orderLogId], references: [id], onDelete: SetNull)
  // Positive to award, negative to roll back.
  entries    Int
  note       String?
  // Prevents double-awarding (e.g. "action:<id>:<day>" or "order:<id>").
  dedupeKey  String?
  createdAt  DateTime     @default(now())

  @@unique([campaignId, dedupeKey])
  @@index([entrantId])
}

enum OrderLogStatus {
  ENTRIES
  NO_ENTRIES
  NO_USER
  ROLLED_BACK_EDIT
  ROLLED_BACK_CANCELLED
}

model OrderLog {
  id             String         @id @default(cuid())
  campaignId     String
  campaign       Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  shopifyOrderId String
  orderName      String?
  email          String?
  status         OrderLogStatus
  entries        Int            @default(0)
  // Per-rule breakdown from the scoring engine, shown in the admin order log.
  breakdown      Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  events EntryEvent[]

  @@unique([campaignId, shopifyOrderId])
}

model RiskSignal {
  id        String   @id @default(cuid())
  entrantId String
  entrant   Entrant  @relation(fields: [entrantId], references: [id], onDelete: Cascade)
  code      String
  weight    Int
  detail    String?
  createdAt DateTime @default(now())

  @@index([entrantId])
}

model EmailOtp {
  id        String    @id @default(cuid())
  entrantId String
  entrant   Entrant   @relation(fields: [entrantId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([entrantId])
}

// Sliding-window counters for rate limiting (key = scope:hash).
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Draw {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // Hex seed and a hash of the eligible-entrant snapshot, so a draw can be re-verified.
  seed          String
  snapshotHash  String
  totalEntries  Int
  eligibleCount Int
  createdBy     String?
  createdAt     DateTime @default(now())

  winners    Winner[]
  dailyPrize DailyPrize?
}

model Winner {
  id             String    @id @default(cuid())
  drawId         String
  draw           Draw      @relation(fields: [drawId], references: [id], onDelete: Cascade)
  entrantId      String
  entrant        Entrant   @relation(fields: [entrantId], references: [id], onDelete: Cascade)
  position       Int
  notifiedAt     DateTime?
  forfeited      Boolean   @default(false)
  // Prize claim: the winner confirms shipping details through a tokenized link.
  claimedAt      DateTime?
  claimData      Json?
  // Daily prizes: the $0 Shopify order created when the winner claims.
  prizeOrderId   String?
  prizeOrderName String?
}

// Prize images uploaded from the admin, served publicly at /images/<id>.
model CampaignImage {
  id          String   @id @default(cuid())
  shop        String
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  shop      String
  actor     String?
  action    String
  target    String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}

enum DailyPrizeStatus {
  // Picked and held back in Shopify (moved from available to reserved).
  RESERVED
  // Drawn; the unit stays reserved until the prize is sent.
  DRAWN
  // Sent to the winner; the reserved unit was removed from inventory.
  SENT
  // Back in normal stock: nobody entered, or the merchant released or swapped it.
  RELEASED
}

// One prize per day for giveaways with the daily draw on (settings.daily). Each picks a
// product from inventory, reserves one unit, and is drawn from that day's entries only.
model DailyPrize {
  id              String           @id @default(cuid())
  campaignId      String
  campaign        Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // Local date (in the campaign timezone) of the draw that closes this prize's day.
  periodKey       String
  opensAt         DateTime
  drawAt          DateTime
  productId       String
  variantId       String
  productHandle   String?
  title           String
  imageUrl        String?
  value           Float
  inventoryItemId String
  locationId      String
  // Where the reserved unit came from: "available" or "safety_stock". Released units go back there.
  reservedFrom    String           @default("available")
  // Bundle prizes: every reserved line as PrizeItem[] (app/lib/bundles.ts). The single-product
  // fields above then hold the first line, with title/value/imageUrl for the whole bundle.
  items           Json?
  status          DailyPrizeStatus @default(RESERVED)
  drawId          String?          @unique
  draw            Draw?            @relation(fields: [drawId], references: [id], onDelete: SetNull)
  note            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([campaignId, periodKey])
  @@index([status, drawAt])
}

// Products the merchant lined up as upcoming daily prizes. Each day's pick takes the item
// pinned to that day, else the next unpinned one in stock; an empty queue falls back to the
// automatic pick.
model DailyQueueItem {
  id         String    @id @default(cuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId  String
  title      String
  imageUrl   String?
  position   Int
  // Local date (YYYY-MM-DD, the draw's date) this item must be the prize for.
  pinnedDate String?
  // A bundle: BundlePart[] (app/lib/bundles.ts). productId/title/imageUrl then describe it.
  bundle     Json?
  usedAt     DateTime?
  prizeId    String?
  // Why it was passed over last time (e.g. out of stock).
  note       String?
  createdAt  DateTime  @default(now())

  @@index([campaignId, usedAt, position])
}

// Daily count of clicks on a giveaway's follow/join buttons (Whatnot etc.), for the ad report.
// Holds no personal data: one row per store, Central Time date, giveaway link name and platform.
model FollowClickDay {
  id        String   @id @default(cuid())
  shop      String
  // YYYY-MM-DD in America/Chicago.
  date      String
  // The giveaway's link name (Campaign.slug) when the click was counted.
  giveaway  String
  platform  String
  clicks    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([shop, date, giveaway, platform])
  @@index([date])
}

// Small app-wide values the app keeps up to date itself, e.g. the refreshed Instagram API token
// (key "instagram_token"). Secrets here never leave the server.
model AppValue {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Cardbit bot and fraud guard (app/lib/cardbit-guard*.ts). One row per customer.
model CardbitRiskProfile {
  shop             String
  customerId       String
  // ok | review (shipping, buybacks, top-ups and free rewards paused) | blocked | trusted
  status           String    @default("ok")
  // [{ code, detail, at }] newest last
  reasons          Json      @default("[]")
  accountCreatedAt DateTime?
  phoneVerifiedAt  DateTime?
  reviewedBy       String?
  reviewedAt       DateTime?
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@id([shop, customerId])
  @@index([shop, status])
}

// Keyed hashes of devices and payment cards seen per customer, to spot one person behind many accounts.
model CardbitRiskSignal {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  // device | card
  kind       String
  valueHash  String
  createdAt  DateTime @default(now())

  @@unique([shop, kind, valueHash, customerId])
  @@index([shop, kind, valueHash])
}

// What the guard refused, or would have refused while CARDBIT_GUARD=log.
model CardbitGuardEvent {
  id         String   @id @default(cuid())
  shop       String
  customerId String?
  action     String
  rule       String
  detail     String?
  enforced   Boolean
  createdAt  DateTime @default(now())

  @@index([shop, createdAt])
  @@index([shop, customerId])
}

// ==== Standalone site: shipping + transactional email (branch cardbit-site) ====
// Owned by the shipping/email work. SiteCopy and customers live in the lead's block.

// One vault shipment request. Copies are locked VAULTED -> SHIP_LOCKED when it is created.
model SiteShipment {
  id                  String    @id @default(cuid())
  customerId          String
  // DRAFT -> PAID -> LABEL_PURCHASED -> IN_TRANSIT -> DELIVERED; RETURNED / EXCEPTION / CANCELED
  status              String    @default("DRAFT")
  toName              String
  toEmail             String?
  toAddress           Json
  addressValidated    Boolean   @default(false)
  cardCount           Int
  // FREE (over 30 cards) | CARDBITS (600) | USD ($6)
  feeKind             String
  feeBits             Int       @default(0)
  feeCents            Int       @default(0)
  paymentRef          String?
  idempotencyKey      String    @unique
  shippoShipmentId    String?
  shippoRateId        String?
  shippoTransactionId String?   @unique
  carrier             String?
  service             String?
  postageCents        Int?
  trackingNumber      String?
  trackingUrl         String?
  labelUrl            String?
  trackingStatus      String?
  trackingDetail      String?
  processBy           DateTime
  shippedAt           DateTime?
  deliveredAt         DateTime?
  canceledAt          DateTime?
  // Package and weight the label was bought with (staff choice or auto-pick; see packages.server.ts).
  packageId           String?
  weightOz            Float?
  parcel              Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  items               SiteShipmentItem[]
  events              SiteShipmentEvent[]

  @@index([customerId, createdAt])
  @@index([status, processBy])
  @@index([carrier, trackingNumber])
}

// Saved shipping packages for the label desk (like Shopify's saved packages). One isDefault.
// Auto-pick: the smallest active package whose maxCards fits the shipment, else the default.
model SiteShipPackage {
  id        String   @id @default(cuid())
  name      String
  // MAILER | BOX | ENVELOPE (soft packaging vs rigid box; shown to staff)
  kind      String   @default("MAILER")
  lengthIn  Float
  widthIn   Float
  heightIn  Float
  // Empty package weight, including filler.
  weightOz  Float
  maxCards  Int?
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, maxCards])
}

model SiteShipmentItem {
  id         String       @id @default(cuid())
  shipmentId String
  shipment   SiteShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  copyId     String
  title      String
  image      String?
  slot       Int?
  pocket     Int?

  @@unique([shipmentId, copyId])
  @@index([copyId])
}

// Audit trail and webhook dedupe for shipments.
model SiteShipmentEvent {
  id         String       @id @default(cuid())
  shipmentId String
  shipment   SiteShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  kind       String
  fromStatus String?
  toStatus   String?
  actor      String
  detail     Json?
  dedupeKey  String?      @unique
  createdAt  DateTime     @default(now())

  @@index([shipmentId, createdAt])
}

// Transactional email outbox. dedupeKey makes each logical email send at most once.
model SiteEmail {
  id         String    @id @default(cuid())
  kind       String
  to         String
  subject    String
  dedupeKey  String    @unique
  payload    Json
  // PENDING -> SENT | FAILED (retried) | REJECTED (bad address, not retried)
  status     String    @default("PENDING")
  providerId String?
  attempts   Int       @default(0)
  error      String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, createdAt])
}
// ---- Cardbit standalone site: core (lead thread) -------------------------------------------
// Used only on cardbit-mystery-packs / site / app-site (CARDBIT_SITE=on). The Shopify setup
// never reads or writes these tables.

model SiteCustomer {
  id        String   @id @default(cuid())
  email     String   @unique // lowercased
  googleSub String?  @unique
  name      String?
  signupMethod String? // email | google | apple | discord | demo (set once, at account creation)
  termsVersion    String? // Terms + Privacy version agreed to at the latest sign-in (clickwrap on every sign-in)
  termsAcceptedAt DateTime?
  riskStatus      String   @default("ok") // ok | review (shipping waits for staff) | trusted (staff vouched; no automatic review)
  riskNote        String?
  tags            String[] @default([]) // staff tags (Card Broker Customers), lowercased, Shopify-style
  staffNote       String? // staff-only note about the customer (Card Broker Customers)
  frozenAt  DateTime?
  closedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSession {
  id         String   @id // sha256 of the cookie token
  customerId String
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  @@index([customerId])
}

model SiteEmailCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime @default(now())
  @@index([email, createdAt])
}

// Balance in Cardbits. Paid and promotional funds are tracked separately (ledger kinds).
model SiteWallet {
  customerId String   @id
  balance    Int      @default(0)
  updatedAt  DateTime @updatedAt
}

// Marketing consent for the standalone site (Welcome Rewards and the Daily Giveaway email requirement).
model SiteMarketing {
  customerId     String    @id
  emailOptInAt   DateTime?
  emailOptOutAt  DateTime?
  smsPhone       String?   @unique // E.164, US only
  smsRequestedAt DateTime?
  smsConfirmedAt DateTime?
  smsOptOutAt    DateTime?
  emailSource    String? // where the latest email consent change came from: welcome-rewards | account | staff | klaviyo
  smsSource      String? // same, for text alerts
  termsVersion   String?
  ip             String?
  syncedAt       DateTime?
  updatedAt      DateTime  @updatedAt
}

// Klaviyo marketing events (cardbit.com only). Producers insert with a dedupeKey; klaviyo.server.ts sends
// them when KLAVIYO_PRIVATE_KEY is set on app-site. Only customers with marketing consent get rows.
model SiteKlaviyoEvent {
  id         String    @id @default(cuid())
  dedupeKey  String    @unique
  customerId String
  metric     String
  properties Json
  value      Float?
  time       DateTime
  status     String    @default("PENDING") // PENDING | SENT | FAILED (retried) | REJECTED | SKIPPED
  attempts   Int       @default(0)
  nextAt     DateTime  @default(now())
  error      String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  @@index([status, nextAt])
}

model SiteLedger {
  id             String   @id @default(cuid())
  customerId     String
  delta          Int
  balanceAfter   Int
  kind           String // TOPUP | BONUS | PACK | SINGLE | BUYBACK | SHIPPING | REFUND | CHARGEBACK | ADJUST | REWARD | SUBSCRIPTION
  ref            String?
  idempotencyKey String   @unique
  note           String?
  createdAt      DateTime @default(now())
  @@index([customerId, createdAt])
}

// One row per physical copy. Status changes are conditional UPDATEs, so each copy has one owner.
model SiteCopy {
  id          String   @id @default(cuid())
  receiptKey  String   @unique // Card Broker eventKey + ":" + unit
  printingKey String
  tcgplayerId Int?
  title       String
  game        String
  setName     String
  number      String
  name        String
  finish      String
  language    String
  condition   String
  image       String?
  slot        Int?
  pocket      Int?
  lookKey     String
  faceKey     String
  status      String   @default("DRAFT") // DRAFT | FOR_SALE | POOLED | VAULTED | SHIP_LOCKED | SHIPPED | REMOVED
  retailBits  Int?
  ownerId     String?
  poolSlotId  String?  @unique
  orderId     String?
  packId      String? // set while POOLED in a SitePack pool
  pulledTier  String? // tier when it was pulled from a pack (auto tiers move; a pull's tier never does)
  autoRestock Boolean  @default(false) // sold back, waiting for the hourly automatic restock to route it
  era         String? // "Modern" | "Vintage" from Card Broker; null = worked out from the set name
  restockId   String? // staged in a pack's pending restock (add while DRAFT, remove while POOLED); locked meanwhile
  openingId   String? // pack opening that delivered this copy
  position    Int?
  demo        Boolean  @default(false) // staff-marked demo stock; removed by Wipe Demo before launch
  // Item kind and product data (Shopify-gap audit, Nov 25): graded slabs and sealed product will be sold later
  // through mystery products. Raw singles keep kind "card" and leave the slab/sealed fields empty.
  kind        String   @default("card") // card | slab | sealed
  rarity      String?
  grader      String? // slabs: PSA | BGS | CGC | SGC | TAG | ...
  grade       String? // slabs: "10", "9.5", "Authentic"
  certNumber  String? // slabs: grading company's certification number
  sealedType  String? // sealed: Booster Box | Elite Trainer Box | Booster Pack | Collection Box | Tin | ...
  weightOz    Float? // shipping weight of this one item when it differs from a sleeved card (slabs, sealed)
  photos      Json? // ["https://…front", "https://…back"] photos of this exact item (stock image stays in `image`)
  acquiredVia String? // how the owner got it when not a pack or Card Shop buy: "spin" | "sparks" (Spark Shop cards can't be sold back)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([slot, pocket])
  @@unique([slot, lookKey])
  @@index([restockId])
  @@unique([slot, faceKey])
  @@index([status, printingKey])
  @@index([ownerId, status])
  @@index([packId, status])
}

model SiteCopyEvent {
  id         String   @id @default(cuid())
  copyId     String
  fromStatus String?
  toStatus   String
  actor      String
  reason     String
  createdAt  DateTime @default(now())
  @@index([copyId, createdAt])
}

model SiteIntakeReceipt {
  eventKey  String   @id
  digest    String
  response  Json
  createdAt DateTime @default(now())
}
// One Coinflow card checkout for a Cardbits top-up. Credited once on Coinflow "Settled".
model SiteTopup {
  id           String   @id @default(cuid())
  customerId   String
  baseBits     Int
  bonusBits    Int
  cents        Int
  provider     String   @default("coinflow") // coinflow | stripe
  status       String   @default("PENDING") // PENDING | CREDITED | REFUNDED | CHARGEBACK | CHARGEBACK_WON | CHARGEBACK_LOST
  paymentId    String?  @unique
  billingState String
  billingZip   String
  ip           String?
  ipRegion     String?
  deviceId     String? // Coinflow/nSure device ID at checkout (chargeback evidence)
  userAgent    String?
  promoCode    String? // SitePromoCode.code used at checkout; its bonus is already inside bonusBits
  promoBits    Int      @default(0) // the part of bonusBits that came from the promo code
  riskLevel    String? // normal | elevated | highest, set when credited (risk.server.ts)
  riskReasons  Json?
  clawedBits   Int      @default(0) // Cardbits taken back on refund/chargeback
  owedBits     Int      @default(0) // part already spent that could not be taken back
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([customerId, createdAt])
}

// Raw processor webhook log (dedupe + audit). No card data is ever in these payloads.
model SiteWebhookEvent {
  id          String    @id // sha256 of raw body
  provider    String
  eventType   String
  ref         String?
  payload     Json
  result      String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

// Site pack editions (cobalt/prism/gold/ember/amethyst). Pool = SiteCopy rows with packId + POOLED.
model SitePack {
  id           String   @id
  title        String
  priceBits    Int
  cardsPerPack Int      @default(1)
  active       Boolean  @default(false)
  sortOrder    Int      @default(0)
  tierRules    Json? // [{name, min}] in Cardbits of card value, lowest first; null = default ladder
  // EV (internal only, Trevor Nov 25): pool's Poke-Collect retail ÷ (packs left × pack price), in %.
  targetEvPct  Int? // e.g. 110; null = automatic buyback routing off for this pack
  evBandPct    Int      @default(5) // allowed ± around the target
  minTopPer100 Int? // minimum top-tier cards per 100 in the pool (routing favours packs below it)
  languages    Json? // ["English","Japanese"] eligible card languages; null = any
  eras         Json? // ["Modern","Vintage"] eligible eras; null = any
  // Pool rules (Trevor, Nov 25): value range, mix caps and auto-scaling tiers.
  minValueBits Int? // cards below this Poke-Collect retail can't join the pool
  maxValueBits Int? // cards above it can't join
  typeCaps     Json? // {"Japanese": 30, "Vintage": 10, ...} max % of the pool per type
  tierMix      Json? // [{name, pct}] lowest first; null = pyramid 50/25/15/8/2
  topTierMin   Int? // minimum value for the top tier (else the pool is flagged Needs Restock)
  tiersAt      DateTime? // last automatic tier recompute
  autoDrafts   Boolean  @default(false) // hourly auto-restock may also pool listed Draft cards (needs a Target EV, or Fill Rules for prize pools)
  // Prize pools (Trevor, Nov 26): "pack" is sold as a pack; "spin" is one Daily Spin's card prizes (id spin-<tier>);
  // "sparks" is the Spark Shop. Prize pools are never sold for Cardbits and have no EV.
  kind         String   @default("pack")
  fillTargets  Json? // prize pools: [{minBits, maxBits, count}] keep about `count` cards in each value range (auto-fill)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteOpening {
  id         String   @id @default(cuid())
  customerId String
  packId     String
  priceBits  Int
  sealed     Boolean  @default(false)
  demo       Boolean  @default(false) // given free from the staff Demo panel
  revealedAt DateTime? // set when the cards are shown (immediately, or on reveal of a saved pack)
  reversedAt DateTime? // staff reversed it from Card Broker: Cardbits returned, cards back in stock
  reversedBy String?
  reverseReason String?
  createdAt  DateTime @default(now())
  @@index([customerId, createdAt])
  @@index([revealedAt])
  fair       SiteOpeningFair?
}

// Current price per printing (retail and buyback offer, in Cardbits). Staff-set or fed by Card Broker.
model SitePrice {
  printingKey String   @id
  retailBits  Int?
  buybackBits Int?
  source      String   @default("staff")
  updatedAt   DateTime @updatedAt
}

model SiteWant {
  customerId String
  cardKey    String
  createdAt  DateTime @default(now())
  @@id([customerId, cardKey])
}

// Idempotent store actions: one row per (customer, client requestId).
model SiteRequest {
  id          String   @id // customerId + ":" + requestId
  fingerprint String
  result      Json
  createdAt   DateTime @default(now())
}

// iPhone app sign-in hand-off: the site's sign-in page (in Apple's sign-in sheet) mints a
// one-time code bound to the app's PKCE challenge; the app trades code + verifier for a session.
model SiteAppHandoff {
  id         String    @id // sha256 of the one-time code
  customerId String
  challenge  String    // base64url(sha256(verifier)) from the app
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  usedAt     DateTime?
  @@index([customerId])
}

// Responsible-play controls (Top-Up / Pack Spend Limits, Cool-Off, Self-Exclusion). app/site/play/limits.server.ts
model SitePlayControl {
  customerId    String    @id
  limits        Json      @default("{}") // {"topup:day": cents, "spend:week": Cardbits, ...}
  pending       Json      @default("[]") // raised/removed limits waiting 24h: [{key, value|null, at}]
  coolOffUntil  DateTime?
  excludedUntil DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SitePlayEvent {
  id         String   @id @default(cuid())
  customerId String
  kind       String // limit_set | limit_raise_requested | limit_raise_canceled | limit_applied | cool_off | self_exclusion
  detail     Json
  createdAt  DateTime @default(now())
  @@index([customerId, createdAt])
}

// Verified Shuffle: per-customer commit-reveal seeds (app/site/play/fair.server.ts).
model SiteFairSeed {
  id             String            @id @default(cuid())
  customerId     String
  serverSeed     String // secret until revealedAt
  serverSeedHash String
  clientSeed     String
  nonce          Int               @default(0)
  revealedAt     DateTime?
  createdAt      DateTime          @default(now())
  openings       SiteOpeningFair[]
  @@index([customerId, revealedAt])
}

model SiteOpeningFair {
  openingId      String       @id
  opening        SiteOpening  @relation(fields: [openingId], references: [id], onDelete: Cascade)
  seedId         String
  seed           SiteFairSeed @relation(fields: [seedId], references: [id])
  serverSeedHash String
  clientSeed     String
  nonce          Int
  poolIds        Json // pack's remaining copy ids, ascending, at draw time
  pickIds        Json // drawn copy ids in pick order
  poolVersion    Int? // pack pool version (SiteRestock.version) in force at draw time
  createdAt      DateTime     @default(now())
  @@index([seedId])
}

// Cardbit Club subscriptions (app/site/play/subscriptions.server.ts). OFF unless SITE_SUBSCRIPTIONS=on.
model SiteSubscription {
  id               String    @id @default(cuid())
  customerId       String
  tier             String // plus | pro | ultimate
  provider         String    @default("coinflow")
  providerRef      String    @unique // processor subscription id
  status           String    @default("PENDING") // PENDING | ACTIVE | PAST_DUE | CANCELED | EXPIRED
  currentPeriodEnd DateTime?
  canceledAt       DateTime?
  cancelReason     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  payments         SiteSubscriptionPayment[]
  @@index([customerId, status])
}

model SiteSubscriptionPayment {
  id             String           @id @default(cuid())
  subscriptionId String
  subscription   SiteSubscription @relation(fields: [subscriptionId], references: [id])
  customerId     String
  paymentId      String           @unique
  cents          Int
  paidBits       Int
  bonusBits      Int
  periodStart    DateTime
  periodEnd      DateTime
  status         String           @default("CREDITED") // CREDITED | REFUNDED | CHARGEBACK
  clawedBits     Int              @default(0)
  owedBits       Int              @default(0)
  createdAt      DateTime         @default(now())
  @@index([customerId, createdAt])
}

// Site live chat. "main" is for every signed-in 18+ account; "club" is for Cardbit Club members.
// Author badges and avatar are snapshotted when the message is sent so reads stay one query.
model SiteChatMessage {
  id         String    @id @default(cuid())
  room       String // main | club
  customerId String
  name       String
  iconId     String?
  iconColor  String?
  badge      String? // staff | plus | pro | ultimate
  level      Int? // author's level when sent
  body       String
  replyToId  String? // quoted message; snapshot below, hidden once the original is removed
  replyName  String?
  replyBody  String?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  deletedBy  String?
  @@index([room, createdAt])
  @@index([customerId, createdAt])
}

// Chat auto-moderation queue (Trevor 2026-11-26). One row per thing staff may want to see: a message the instant
// filter or the AI check stopped (source filter|ai; the message never posted, body kept here), a posted message the AI
// flagged for a look without hiding (ai, strike false), or a player's report of a posted message (report, one per
// reporter per message). strike = counts toward automatic mutes until staff dismiss it.
model SiteChatFlag {
  id         String    @id @default(cuid())
  source     String // filter | ai | report
  status     String    @default("open") // open | dismissed | actioned
  category   String // hate | threat | harassment | sexual | scam | off_platform | personal_info | spam | self_harm | other ...
  severity   Int       @default(1) // 1 low, 2 medium, 3 high
  strike     Boolean   @default(false)
  hidden     Boolean   @default(false) // true when the message was stopped or auto-hidden
  room       String
  customerId String // author
  messageId  String? // posted message, when there is one
  body       String
  reason     String?
  reporterId String?
  model      String?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  reviewedBy String?
  @@unique([messageId, reporterId])
  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

model SiteChatMute {
  customerId String   @id
  until      DateTime
  reason     String?
  byEmail    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Site analytics (app/site/analytics). First-party only: one SiteVisit per browsing session
// (ends after 30 idle minutes), one SitePageView per page. Read by Card Broker's Analytics tab.
model SiteVisit {
  id           String    @id @default(cuid())
  visitorId    String // random first-party cookie (cb_vid), not tied to anything else
  customerId   String?
  newVisitor   Boolean   @default(true)
  staff        Boolean   @default(false) // a SITE_STAFF_EMAILS account was signed in
  startedAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  landingPath  String
  exitPath     String
  pageviews    Int       @default(1)
  referrerHost String?
  source       String // direct | search | social | discord | email | sms | paid | referral | campaign
  sourceName   String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  device       String // desktop | mobile | tablet
  browser      String?
  os           String?
  country      String?
  region       String?
  @@index([startedAt])
  @@index([lastSeenAt])
  @@index([visitorId])
  @@index([customerId, startedAt])
}

model SitePageView {
  id        String   @id @default(cuid())
  visitId   String
  path      String
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([visitId])
}

// ---- end Cardbit standalone site: core ------------------------------------------------------

// Verified restocks (Trevor, Nov 25): a pack pool changes only when staff publish a restock. Each
// publish is a numbered pool version with its full copy list and SHA-256 hash, shown on the pack page.
// Restocks go live the moment staff press Publish (Trevor chose "Instant, logged").
model SiteRestock {
  id        String    @id @default(cuid())
  packId    String
  status    String    @default("STAGED") // STAGED (one per pack, collects cards) | LIVE
  version   Int? // 1, 2, 3… per pack once LIVE
  addIds    Json      @default("[]") // copy ids added to the pool by this version
  removeIds Json      @default("[]") // copy ids taken out of the pool by this version
  poolIds   Json? // every copy id in the pool right after publish, ascending
  poolHash  String? // sha256(poolIds joined by "\n")
  poolSize  Int?
  tiers     Json? // {Common: n, …} of the cards added
  note      String?
  actor     String?
  auto      Boolean   @default(false) // hourly automatic buyback restock
  evPct     Float? // internal: pool EV right after publish (Poke-Collect retail basis)
  tierRules Json? // auto tier cutoffs in force from this version
  liveAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@unique([packId, version])
  @@index([packId, status])
}

// Promo codes (Trevor 2026-11-25): entered at Cardbits checkout, add bonus Cardbits to that top-up.
// One use per customer; optional total cap, dates, minimum top-up and first-top-up-only.
model SitePromoCode {
  code           String    @id // upper case, A-Z 0-9 and dashes
  kind           String // PERCENT (value = % of the paid Cardbits) | FLAT (value = Cardbits)
  value          Int
  maxBonusBits   Int? // cap on a PERCENT bonus
  maxUses        Int? // total credited uses allowed
  minCents       Int? // smallest top-up it applies to
  firstTopupOnly Boolean   @default(false)
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean   @default(true)
  note           String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Redeem codes (Trevor 2026-11-26): single-use codes that add a fixed number of promotional Cardbits on their own,
// with no purchase. First campaign: PCBF = Poke-Collect Black Friday ($200+ orders Nov 27-30 earn 1,000 Cardbits;
// Poke-Collect emails each qualifying customer one code). One code per account per campaign.
model SiteRedeemCampaign {
  key       String    @id // code prefix, e.g. PCBF
  name      String // customer-facing, e.g. "Poke-Collect Black Friday"
  bits      Int // Cardbits each code adds (BONUS)
  expiresAt DateTime? // last moment a code can be redeemed (null = no end date)
  active    Boolean   @default(true)
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model SiteRedeemCode {
  code       String    @id // PCBF-XXXXXXXX as handed out
  compact    String    @unique // upper case, dashes and spaces removed (what a customer's entry is matched on)
  campaign   String
  batch      String // when and by whom the codes were made, for the CSV
  redeemedBy String? // SiteCustomer.id
  redeemedAt DateTime?
  voidedAt   DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())
  @@unique([campaign, redeemedBy]) // one code per account per campaign (NULLs don't collide)
  @@index([campaign, createdAt])
}

// Staff notes on one order (Card Broker order page), Shopify-style. orderType + orderRef match the Orders feed row.
model SiteOrderNote {
  id         String   @id @default(cuid())
  orderType  String // PACK | SINGLE | BUYBACK | SHIPPING | TOPUP
  orderRef   String // the Orders feed row id
  customerId String
  body       String
  actor      String
  createdAt  DateTime @default(now())
  @@index([orderType, orderRef, createdAt])
  @@index([customerId, createdAt])
}

// Audit trail of staff actions taken from Card Broker on customers and orders (adjust, reverse, close, erase...).
model SiteStaffAction {
  id         String   @id @default(cuid())
  action     String // adjust | reverse_pack | reverse_single | close | reopen | export | erase
  actor      String
  customerId String?
  orderType  String?
  orderRef   String?
  reason     String?
  detail     Json?
  requestId  String?  @unique // Card Broker's request id: a retried click never acts twice
  createdAt  DateTime @default(now())
  @@index([customerId, createdAt])
  @@index([orderType, orderRef])
  @@index([createdAt])
}

// Sales tax economic nexus alerts already sent (one per state, band and measuring period).
model SiteNexusAlert {
  id        String   @id // state + ":" + band + ":" + period
  state     String
  band      Int // 70 | 90 | 100 (% of the state's threshold)
  period    String
  createdAt DateTime @default(now())
}

// Coming-soon waitlist (cardbit.com before launch). Founding Collectors: badge + 1,000 Cardbits (400 email,
// 600 confirmed phone) that unlock with the first top-up on an account with the same email (Trevor, Nov 25 2026).
model SiteWaitlist {
  id            String    @id @default(cuid())
  emailKey      String    @unique // normalized for duplicate checks (lowercase; Gmail dots and +tags removed)
  email         String    // lowercased, as typed
  phone         String?   @unique // E.164, US only; given with text consent
  smsConsentAt  DateTime?
  emailConsentAt DateTime
  termsVersion  String
  ip            String?
  userAgent     String?
  source        Json?     // utm_* and referrer
  customerId    String?   @unique // site account that claimed the bonus
  claimedAt     DateTime?
  emailBonusAt  DateTime?
  smsBonusAt    DateTime?
  syncedAt      DateTime? // Klaviyo email consent + profile properties
  smsSyncedAt   DateTime? // Klaviyo text consent (sent once KLAVIYO_SMS_LIST_ID is set)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([ip, createdAt])
  @@index([syncedAt])
}

// ---- Cardbit standalone site: Discord community (Nov 25 2026) ---------------------------------
// A customer's linked Discord account, for the site-rank Linked Roles (Rookie → Mythic) on the Cardbit
// Discord server and the opt-in live pulls feed. Tokens are AES-GCM encrypted and only carry the
// `identify role_connections.write` scopes. Unlinking deletes the row.
model SiteDiscordLink {
  customerId    String    @id
  discordUserId String    @unique
  discordName   String?
  accessToken   String? // encrypted; null once Discord revokes it (customer must link again)
  refreshToken  String? // encrypted
  expiresAt     DateTime?
  pushedLevel   Int? // level last sent to Discord
  pushedPassTier Int? // Pack Pass tier last sent (0 none, 1 Plus, 2 Pro, 3 Ultimate)
  pushedAt      DateTime?
  shareFeedAt   DateTime? // opted in to the live pulls feed at this time; null = off (default)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// One row per pull posted (or attempted) to the Discord pulls feed, so a pull is never posted twice.
model SiteDiscordPost {
  copyId     String   @id
  customerId String
  openingId  String
  postedAt   DateTime?
  error      String?
  createdAt  DateTime @default(now())
  @@index([customerId])
}

// Ask Latch: AI help chat on cardbit.com (app/site/help). Answers only from published site pages.
// Kept 90 days for staff review (Card Broker), then deleted. visitorKey = "c:<customerId>" or "v:<random cookie>".
model SiteHelpConversation {
  id           String            @id @default(cuid())
  customerId   String?
  visitorKey   String
  ipHash       String?
  page         String // waitlist | site
  messageCount Int               @default(0)
  handoff      Boolean           @default(false) // the bot pointed the visitor to support@cardbit.com
  flagged      Boolean           @default(false) // staff flag
  reviewedAt   DateTime?
  reviewedBy   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  messages     SiteHelpMessage[]
  @@index([createdAt])
  @@index([customerId])
  @@index([visitorKey, createdAt])
  @@index([ipHash, createdAt])
}

model SiteHelpMessage {
  id              String               @id @default(cuid())
  conversationId  String
  conversation    SiteHelpConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            String // user | assistant
  body            String
  model           String?
  inputTokens     Int?
  outputTokens    Int?
  cacheReadTokens Int?
  error           String?
  createdAt       DateTime             @default(now())
  @@index([conversationId, createdAt])
  @@index([createdAt])
}
