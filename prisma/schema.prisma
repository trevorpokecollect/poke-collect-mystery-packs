// Prisma schema for the Poke-Collect mystery pack app.
// Hosted on Railway Postgres; DATABASE_URL is provided by the Railway Postgres plugin.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum SeriesStatus {
  DRAFT // cards being set up, not on sale
  LIVE // pool shuffled and committed, packs on sale
  CLOSED // no longer drawing (sold out or closed by the merchant)
}

// One sellable run of packs with a fixed card list, e.g. "Series 1: 500 packs at $10".
model Series {
  id               String       @id @default(cuid())
  shop             String
  title            String
  handle           String
  status           SeriesStatus @default(DRAFT)
  // The Shopify product variant customers buy (the pack itself).
  packProductId    String
  // Reusable across series: only one draft or live series may use a pack at a time.
  packVariantId    String
  packPrice        Decimal      @db.Decimal(10, 2)
  // Unopened packs are revealed automatically after this many days so orders can ship.
  autoOpenDays     Int          @default(1)
  // Auto-built pools draw from the shop's live inventory: each card's copies are moved to
  // "reserved" at launch so they can only be won from packs, and released when the series closes.
  reserveInventory Boolean      @default(false)
  // [{ name, min }] lowest first; a card's tier is the highest one its value reaches.
  tierRules        Json?
  // Last rules used to auto-build the pool, to prefill the form.
  buildRules       Json?
  // Provable fairness: sha256(salt + ordered slot list) published at launch,
  // salt published after the series closes.
  commitHash       String?
  salt             String?
  launchedAt       DateTime?
  closedAt         DateTime?
  // Set once when the last card of the top tier is pulled (fires the Shopify Flow alert).
  topTierGoneAt    DateTime?
  // Cards in each pack (1 for classic packs; e.g. 5 for a booster-style pack). Each card is its own slot.
  cardsPerPack     Int          @default(1)
  // What the pool's cards would cost at our StorePass buylist offers (see lib/buylist.server.ts).
  buylistReport    Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  cards Card[]
  slots Slot[]
  pulls Pull[]

  @@unique([shop, handle])
  @@index([shop, packVariantId])
}

// A card in the pool. Each card is a hidden Shopify variant with real inventory.
model Card {
  id              String  @id @default(cuid())
  seriesId        String
  series          Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  variantId       String
  productId       String
  title           String
  imageUrl        String?
  tier            String
  marketValue     Decimal @db.Decimal(10, 2)
  quantity        Int
  sortOrder       Int     @default(0)
  // Where this card's stock is reserved (auto-built pools only).
  inventoryItemId String?
  locationId      String?
  // Copies currently held in Shopify's "reserved" state for this series.
  reservedQty     Int     @default(0)

  slots Slot[]

  @@unique([seriesId, variantId])
}

// One physical copy of a card in a series. At launch every slot is given a
// position in a cryptographically shuffled sequence; packs claim positions in order.
model Slot {
  id       String  @id @default(cuid())
  seriesId String
  series   Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  cardId   String
  card     Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  position Int?
  claimed  Boolean @default(false)
  // Voided slots belonged to a refunded/cancelled unopened pack; the card returns to stock.
  voided   Boolean @default(false)

  pull Pull?

  @@unique([seriesId, position])
  @@index([seriesId, claimed, voided])
}

enum PullStatus {
  UNOPENED // drawn at payment, not yet revealed to the customer
  REVEALED // customer (or auto-open) revealed it
  FULFILLING // card added to the order, holds released
  VOIDED // order refunded or cancelled before the card shipped
}

model Pull {
  id            String       @id @default(cuid())
  shop          String
  seriesId      String
  series        Series       @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  slotId        String       @unique
  slot          Slot         @relation(fields: [slotId], references: [id])
  orderId       String // gid://shopify/Order/...
  orderName     String
  lineItemId    String // gid://shopify/LineItem/... of the pack line
  packIndex     Int // 0-based copy within that line item's quantity
  cardIndex     Int          @default(0) // 0-based card within a multi-card pack
  customerId    String? // gid://shopify/Customer/...
  status        PullStatus   @default(UNOPENED)
  revealedAt    DateTime?
  autoOpened    Boolean      @default(false)
  fulfillingAt  DateTime?
  // Set once this pull's reserved copy is moved back to available for the order edit.
  unreservedAt  DateTime?
  // Vault orders: the "ship to me" request this card is on, and the order that ships it.
  shipRequestId String?
  shipRequest   ShipRequest? @relation(fields: [shipRequestId], references: [id])
  shipOrderId   String?
  // When the customer was reminded this vaulted card is near the end of its holding period.
  remindedAt    DateTime?
  // Vault marketplace: shown on the Trade Board, and when it last changed owners by trade or sale.
  openToTrade   Boolean      @default(false)
  transferredAt DateTime?
  // The pack order was refunded after this card changed owners: staff decide, the card is not voided.
  refundFlaggedAt DateTime?
  createdAt     DateTime     @default(now())
  tradeItems    TradeItem[]
  listings      Listing[]
  transfers     PullTransfer[]

  @@unique([lineItemId, packIndex, cardIndex])
  @@index([orderId])
  @@index([customerId])
  @@index([status, createdAt])
}

// Per-order bookkeeping for orders that contain packs.
model PackOrder {
  orderId              String    @id
  shop                 String
  orderName            String
  customerId           String?
  // Random token for the "open your packs" link (lets guests open without logging in).
  openToken            String    @unique
  // The checkout's token (order.checkout_token), so the thank-you page can find this order's packs.
  checkoutToken        String?
  held                 Boolean   @default(false)
  // Set right after the order edit commits, so a retry never adds the cards twice.
  cardsAddedAt         DateTime?
  // Lease so the reveal request and the cron job never finalize the same order at once.
  finalizingAt         DateTime?
  finalized            Boolean   @default(false)
  // Vault orders keep pulled cards in the customer's vault until they ask to have them shipped,
  // instead of adding them to this order. Orders from before the vault have this false.
  vault                Boolean   @default(false)
  // Vault orders: when the pulled cards were written to the order's note (cards aren't line items).
  pullsNotedAt         DateTime?
  // Vault orders: when the pack lines were marked fulfilled (at payment).
  packLinesFulfilledAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([shop, checkoutToken])
}

// A customer's "ship my cards" request: a draft order for the vaulted cards plus the shipping fee.
model ShipRequest {
  id           String   @id @default(cuid())
  shop         String
  customerId   String?
  // PENDING until the invoice is paid; EXPIRED if it lapses (cards go back to the vault).
  status       String   @default("PENDING")
  draftOrderId String?
  invoiceUrl   String?
  orderId      String?
  cardCount    Int
  shippingFee  Decimal  @db.Decimal(10, 2)
  // Local pickup instead of shipping; readyAt is when the "ready for pickup" email went out.
  pickup       Boolean  @default(false)
  readyAt      DateTime?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  pulls        Pull[]

  @@index([shop, status])
}

// ---- Vault marketplace: players trade or sell vault cards to each other (never to the store) ----

model MarketSettings {
  shop           String   @id
  // Off until the merchant turns it on in the admin; selling has its own switch.
  enabled        Boolean  @default(false)
  sellingEnabled Boolean  @default(false)
  // Kept from each sale before the seller's store credit.
  feePercent     Decimal  @default(10) @db.Decimal(5, 2)
  // Vault Credit codes only work on products in these collections (never Mystery Packs).
  creditCollectionIds String[] @default([])
  // Whether Vault Credit codes combine with other product / order discounts.
  creditCombines Boolean @default(false)
  updatedAt      DateTime @updatedAt
}

// A player's public trade name. Real names and emails are never shown to other players.
model Trader {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  tradeName  String
  nameKey    String // lowercased, for uniqueness
  // Opt-in: other players can browse this player's whole vault (otherwise only cards they put up).
  showCollection Boolean @default(false)
  // Up to 6 pull ids pinned at the top of their collection page.
  showcase   String[] @default([])
  createdAt  DateTime @default(now())

  @@unique([shop, customerId])
  @@unique([shop, nameKey])
}

enum TradeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
  REVERSED
}

// An offer from one player to another: cards given for cards received, final once accepted.
model Trade {
  id             String      @id @default(cuid())
  shop           String
  fromCustomerId String
  toCustomerId   String
  status         TradeStatus @default(PENDING)
  note           String?
  // The offer this one counters (that one is declined when this is sent).
  counterOfId    String?
  expiresAt      DateTime
  respondedAt    DateTime?
  reversedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          TradeItem[]

  @@index([shop, status])
  @@index([fromCustomerId])
  @@index([toCustomerId])
}

model TradeItem {
  id      String @id @default(cuid())
  tradeId String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  pullId  String
  pull    Pull   @relation(fields: [pullId], references: [id])
  // GIVE: the proposer's card. GET: the card the proposer asks for.
  side    String

  @@index([pullId])
}

enum ListingStatus {
  ACTIVE // on the Trade Board with a price
  CHECKOUT // a buyer holds an unpaid invoice for it
  SOLD
  CANCELLED
}

// A vault card a player has put up for sale to other players. The buyer pays through a Shopify
// invoice; the seller gets store credit (price minus the fee) once the hold period passes.
model Listing {
  id                String        @id @default(cuid())
  shop              String
  pullId            String
  pull              Pull          @relation(fields: [pullId], references: [id])
  sellerCustomerId  String
  price             Decimal       @db.Decimal(10, 2)
  status            ListingStatus @default(ACTIVE)
  buyerCustomerId   String?
  draftOrderId      String?
  invoiceUrl        String?
  checkoutExpiresAt DateTime?
  orderId           String?
  orderName         String?
  soldAt            DateTime?
  // HELD until payoutDueAt, then PAID as store credit. FLAGGED (refund/chargeback) or CANCELLED (sale reversed) stop it.
  payoutStatus      String?
  payoutAmount      Decimal?      @db.Decimal(10, 2)
  payoutDueAt       DateTime?
  paidOutAt         DateTime?
  flagReason        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([shop, status])
  @@index([pullId])
  @@index([sellerCustomerId])
  @@index([payoutStatus, payoutDueAt])
}

// Every change of owner made by the marketplace, for staff and reversals.
model PullTransfer {
  id             String   @id @default(cuid())
  shop           String
  pullId         String
  pull           Pull     @relation(fields: [pullId], references: [id])
  fromCustomerId String
  toCustomerId   String
  reason         String // TRADE | SALE | REVERSAL
  tradeId        String?
  listingId      String?
  createdAt      DateTime @default(now())

  @@index([pullId])
}

// A card a player is looking for, by the single's Shopify variant (the same card across series).
model WishItem {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  variantId  String
  title      String
  imageUrl   String?
  // Pulls already emailed about, so each newly available copy alerts once.
  alertedPullIds String[] @default([])
  createdAt  DateTime @default(now())

  @@unique([shop, customerId, variantId])
  @@index([shop, variantId])
}

// Vault Credit: the marketplace's own balance. Shopify checkout never sees it, so it can't buy
// Mystery Packs. Every change is a signed ledger row; the balance is their sum.
model CreditTxn {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  amount     Decimal  @db.Decimal(10, 2)
  // SALE (seller paid) | PURCHASE (bought a card) | CODE (spent on a store code) | CODE_RETURN | ADJUST
  kind       String
  listingId  String?
  codeId     String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([shop, customerId])
}

// A one-time Shopify discount code made from Vault Credit, limited to eligible collections.
model CreditCode {
  id         String   @id @default(cuid())
  shop       String
  customerId String
  code       String   @unique
  amount     Decimal  @db.Decimal(10, 2)
  discountId String?
  // ACTIVE until used, returned or expired.
  status     String   @default("ACTIVE")
  orderId    String?
  orderName  String?
  usedAmount Decimal? @db.Decimal(10, 2)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([shop, customerId])
  @@index([status, expiresAt])
}
