{% comment %}
  Mystery pack "Potential Pulls" block for the pack product page: live odds per tier and a
  "View Potential Pulls" button that opens the full card list at /apps/packs/pool.
  Finds the series from the product, so it works on any pack product without setup.
{% endcomment %}
{%- liquid
  assign handle = block.settings.series_handle | strip
  if handle != blank
    assign query = 'series=' | append: handle
  else
    assign query = 'product=' | append: product.id
  endif
-%}
<div
  class="mp-odds"
  data-mp-odds
  data-endpoint="/apps/packs/api/pool?{{ query }}"
  hidden
  {{ block.shopify_attributes }}
>
  <h3 class="mp-odds__heading">{{ block.settings.heading }}</h3>
  <p class="mp-odds__summary" data-mp-summary></p>
  <ul class="mp-odds__tiers" data-mp-tiers></ul>
  <a class="button button--secondary mp-odds__button" href="/apps/packs/pool?{{ query }}">{{ block.settings.button_label }}</a>
  {% if block.settings.note != blank %}<p class="mp-odds__note">{{ block.settings.note }}</p>{% endif %}
</div>
{{ 'pack-odds.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pack-odds.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Mystery pack odds",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's in the pack" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View Potential Pulls" },
    { "type": "textarea", "id": "note", "label": "Note", "default": "Every pack holds one card from the list, shipped to you after you open it online. Odds update as packs are opened." },
    { "type": "text", "id": "series_handle", "label": "Series handle (optional)", "info": "Leave blank to use the series sold through this product." }
  ]
}
{% endschema %}
