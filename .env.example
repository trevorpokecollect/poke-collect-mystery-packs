# Railway Postgres connection string (Railway sets this automatically when you add Postgres).
DATABASE_URL=postgresql://postgres:password@localhost:5432/packs
# From the Shopify Dev Dashboard app (shopify app env show).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_app_proxy,read_products,write_products,read_inventory,write_inventory,read_locations,read_orders,write_orders,write_order_edits,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_third_party_fulfillment_orders,write_third_party_fulfillment_orders
# Public URL of this app on Railway, e.g. https://poke-collect-mystery-packs.up.railway.app
SHOPIFY_APP_URL=
# Storefront domain used in "open your packs" links.
STOREFRONT_URL=https://poke-collect.com
# Shared secret for the auto-open cron call (any long random string).
CRON_SECRET=
